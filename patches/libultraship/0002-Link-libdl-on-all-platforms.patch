From 3b3dc2d0a7343967c91d3d4a935b0f38b14ca9f6 Mon Sep 17 00:00:00 2001
From: Henning Hollermann <laclaro@mail.com>
Date: Thu, 22 Oct 2026 00:33:14 +0200
Subject: [PATCH 2/5] Link libdl on all platforms

dladdr() is used by CrashHandler and FileDropMgr but ${CMAKE_DL_LIBS}
was only linked on Darwin/iOS. On glibc < 2.34 (e.g. Debian bullseye)
dladdr lives in libdl, so the final link failed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/CMakeLists.txt | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index c5e3a335..103e7f75 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -121,6 +121,9 @@ if (CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
     target_link_libraries(libultraship PRIVATE ${OSX_FOUNDATION} ${OSX_AVFOUNDATION} ${METAL} ${QUARTZCORE} ${COREAUDIO} ${AUDIOTOOLBOX} ${CMAKE_DL_LIBS})
 endif()
 
+# dladdr() (CrashHandler, FileDropMgr) lives in libdl on glibc < 2.34, e.g. Debian bullseye.
+target_link_libraries(libultraship PRIVATE ${CMAKE_DL_LIBS})
+
 if (USE_OPENGLES)
     if (CMAKE_SYSTEM_NAME STREQUAL "Android")
         find_library(OPENGLES_LIBRARY GLESv3)
-- 
