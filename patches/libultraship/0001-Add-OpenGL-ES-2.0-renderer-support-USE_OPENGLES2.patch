+#ifdef USE_OPENGLES2
+static GLuint CompileBlitShader(GLenum type, const char* source) {
+    GLuint shader = glCreateShader(type);
+    glShaderSource(shader, 1, &source, nullptr);
+    glCompileShader(shader);
+    GLint success;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &success);
+    if (!success) {
+        char error_log[1024];
+        glGetShaderInfoLog(shader, sizeof(error_log), nullptr, error_log);
+        fprintf(stderr, "Blit shader compilation failed\n%s\n", error_log);
+        abort();
+    }
+    return shader;
+}
+
+// Copies the rectangle (srcX0, srcY0)-(srcX1, srcY1) of one framebuffer onto (dstX0, dstY0)-(dstX1, dstY1) of
+// another, with glBlitFramebuffer semantics (bottom-left origin, swapped coordinates flip the image).
+// The caller handles the scissor test, as it does around glBlitFramebuffer.
+void GfxRenderingAPIOGL::CopyRegionGLES2(int fb_src_id, int srcX0, int srcY0, int srcX1, int srcY1, int fb_dst_id,
+                                         int dstX0, int dstY0, int dstX1, int dstY1) {
+    const FramebufferOGL& src = mFrameBuffers[fb_src_id];
+    const FramebufferOGL& dst = mFrameBuffers[fb_dst_id];
+
+    if (mBlitProgram == 0) {
+        static const char* vs = "attribute vec2 aPos;\n"
+                                "attribute vec2 aUv;\n"
+                                "varying vec2 vUv;\n"
+                                "void main() {\n"
+                                "    vUv = aUv;\n"
+                                "    gl_Position = vec4(aPos, 0.0, 1.0);\n"
+                                "}\n";
+        static const char* fs = "precision mediump float;\n"
+                                "uniform sampler2D uTex;\n"
+                                "varying vec2 vUv;\n"
+                                "void main() {\n"
+                                "    gl_FragColor = texture2D(uTex, vUv);\n"
+                                "}\n";
+        mBlitProgram = glCreateProgram();
+        glAttachShader(mBlitProgram, CompileBlitShader(GL_VERTEX_SHADER, vs));
+        glAttachShader(mBlitProgram, CompileBlitShader(GL_FRAGMENT_SHADER, fs));
+        glBindAttribLocation(mBlitProgram, 0, "aPos");
+        glBindAttribLocation(mBlitProgram, 1, "aUv");
+        glLinkProgram(mBlitProgram);
+        glUseProgram(mBlitProgram);
+        glUniform1i(glGetUniformLocation(mBlitProgram, "uTex"), 0);
+
+        glGenBuffers(1, &mBlitVbo);
+
+        glActiveTexture(GL_TEXTURE0);
+        glGenTextures(1, &mBlitScratchTex);
+        glBindTexture(GL_TEXTURE_2D, mBlitScratchTex);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+
+    glActiveTexture(GL_TEXTURE0);
+
+    GLuint srcTex;
+    float u0, v0, u1, v1;
+    if (fb_src_id == 0) {
+        // The window surface has no texture to sample: copy the region into a scratch texture first.
+        const int x = std::min(srcX0, srcX1);
+        const int y = std::min(srcY0, srcY1);
+        const int w = std::abs(srcX1 - srcX0);
+        const int h = std::abs(srcY1 - srcY0);
+        if (w == 0 || h == 0) {
+            glBindTexture(GL_TEXTURE_2D, mLastBoundTextures[0]);
+            glActiveTexture(GL_TEXTURE0 + std::max<int>(mLastActiveTexture, 0));
+            return;
+        }
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        glBindTexture(GL_TEXTURE_2D, mBlitScratchTex);
+        glCopyTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, x, y, w, h, 0);
+        srcTex = mBlitScratchTex;
+        u0 = (float)(srcX0 - x) / w;
+        u1 = (float)(srcX1 - x) / w;
+        v0 = (float)(srcY0 - y) / h;
+        v1 = (float)(srcY1 - y) / h;
+    } else {
+        srcTex = src.clrbuf;
+        u0 = (float)srcX0 / src.width;
+        u1 = (float)srcX1 / src.width;
+        v0 = (float)srcY0 / src.height;
+        v1 = (float)srcY1 / src.height;
+    }
+
+    const float x0 = 2.0f * dstX0 / dst.width - 1.0f;
+    const float x1 = 2.0f * dstX1 / dst.width - 1.0f;
+    const float y0 = 2.0f * dstY0 / dst.height - 1.0f;
+    const float y1 = 2.0f * dstY1 / dst.height - 1.0f;
+    const float quad[] = {
+        x0, y0, u0, v0, x1, y0, u1, v0, x0, y1, u0, v1, x1, y1, u1, v1,
+    };
+
+    // Save the state the game renderer relies on (the cached state in mLast* stays valid).
+    GLint prevViewport[4];
