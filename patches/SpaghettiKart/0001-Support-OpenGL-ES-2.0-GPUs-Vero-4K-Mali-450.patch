From 72d4b3755cfafc56f138f16af21899447c6eb208 Mon Sep 17 00:00:00 2001
From: Henning Hollermann <laclaro@mail.com>
Date: Thu, 22 Oct 2026 00:34:02 +0200
Subject: [PATCH 1/5] Support OpenGL ES 2.0 GPUs (Vero 4K+ / Mali-450)

- update libultraship to the vero4k branch, which adds USE_OPENGLES2
  (GLES 2.0 / GLSL ES 1.00 renderer) and links libdl for glibc < 2.34
- apply the matching GLSL ES 1.00 changes to the game's own copy of the
  OpenGL shader template, which is what spaghetti.o2r ships

Configure with -DUSE_OPENGLES=ON -DUSE_OPENGLES2=ON.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 assets/shaders/opengl/default.shader.glsl | 25 +++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/assets/shaders/opengl/default.shader.glsl b/assets/shaders/opengl/default.shader.glsl
index 5e0f93f29..d202a065c 100644
--- a/assets/shaders/opengl/default.shader.glsl
+++ b/assets/shaders/opengl/default.shader.glsl
@@ -77,6 +77,9 @@
         @if(opengles)
             gl_Position.z *= 0.3f;
         @end
+        @if(gles2)
+            gl_Position.z *= 0.3;
+        @end
     }
 @else
     @if(core_opengl || opengles)
@@ -129,15 +132,19 @@
     #define WRAP(x, low, high) mod((x)-(low), (high)-(low)) + (low)
 
     float random(in vec3 value) {
-        float random = dot(sin(value), vec3(12.9898, 78.233, 37.719));
-        return fract(sin(random) * 143758.5453);
+        float r = dot(sin(value), vec3(12.9898, 78.233, 37.719));
+        return fract(sin(r) * 143758.5453);
     }
 
     vec4 fromLinear(vec4 linearRGB){
         bvec3 cutoff = lessThan(linearRGB.rgb, vec3(0.0031308));
         vec3 higher = vec3(1.055)*pow(linearRGB.rgb, vec3(1.0/2.4)) - vec3(0.055);
         vec3 lower = linearRGB.rgb * vec3(12.92);
+    @if(gles2)
+        return vec4(mix(higher, lower, vec3(cutoff)), linearRGB.a);
+    @else
         return vec4(mix(higher, lower, cutoff), linearRGB.a);
+    @end
     }
 
     vec4 filter3point(in sampler2D tex, in vec2 texCoord, in vec2 texSize) {
@@ -149,9 +156,9 @@
         return c0 + abs(offset.x)*(c1-c0) + abs(offset.y)*(c2-c0);
     }
 
-    vec4 hookTexture2D(in int id, sampler2D tex, in vec2 uv, in vec2 texSize) {
+    vec4 hookTexture2D(in int filtering, sampler2D tex, in vec2 uv, in vec2 texSize) {
     @if(o_three_point_filtering)
-        if(texture_filtering[id] == @{FILTER_THREE_POINT}) {
+        if(filtering == @{FILTER_THREE_POINT}) {
             return filter3point(tex, uv, texSize);
         }
     @end
@@ -180,19 +187,21 @@
                     @end
                 @end
 
-                vec4 texVal@{i} = hookTexture2D(@{i}, uTex@{i}, vTexCoordAdj@{i}, texSize@{i});
+                vec4 texVal@{i} = hookTexture2D(texture_filtering[@{i}], uTex@{i}, vTexCoordAdj@{i}, texSize@{i});
 
                 @if(o_masks[i])
-                    @if(opengles)
+                    @if(gles2)
+                        vec2 maskSize@{i} = texSize@{i};
+                    @elseif(opengles)
                         vec2 maskSize@{i} = vec2(textureSize(uTexMask@{i}, 0));
                     @else
                         vec2 maskSize@{i} = textureSize(uTexMask@{i}, 0);
                     @end
 
-                    vec4 maskVal@{i} = hookTexture2D(@{i}, uTexMask@{i}, vTexCoordAdj@{i}, maskSize@{i});
+                    vec4 maskVal@{i} = hookTexture2D(texture_filtering[@{i}], uTexMask@{i}, vTexCoordAdj@{i}, maskSize@{i});
 
                     @if(o_blend[i])
-                        vec4 blendVal@{i} = hookTexture2D(@{i}, uTexBlend@{i}, vTexCoordAdj@{i}, texSize@{i});
+                        vec4 blendVal@{i} = hookTexture2D(texture_filtering[@{i}], uTexBlend@{i}, vTexCoordAdj@{i}, texSize@{i});
                     @else
                         vec4 blendVal@{i} = vec4(0, 0, 0, 0);
                     @end
