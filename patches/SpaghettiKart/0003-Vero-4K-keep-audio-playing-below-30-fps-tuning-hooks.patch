+++ b/src/port/Game.cpp
@@ -7,6 +7,9 @@
 #include <fast/Fast3dWindow.h>
 #include <memory>
 #include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
 #include "engine/World.h"
 #include "engine/AllTracks.h"
 
@@ -983,12 +986,58 @@ static void ApplyPendingReset() {
     gFadeModeSelection = FADE_MODE_LOGO;
 }
 
+extern "C" int GameEngine_GetAudioBufferedBeforeUpdate();
+
+// With SPAGHETTIKART_FRAME_STATS=1, logs frame pacing every 5 s: game fps, where the frame time goes (game+render
+// vs. waiting for the audio thread) and the lowest queued audio. For tuning slow devices such as the Vero 4K+.
+static void LogFramePacing(double frameMs, double gameMs, double audioWaitMs) {
+    static const bool sEnabled = [] {
+        const char* stats = std::getenv("SPAGHETTIKART_FRAME_STATS");
+        return stats != nullptr && std::strcmp(stats, "1") == 0;
+    }();
+    if (!sEnabled) {
+        return;
+    }
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point sStart = Clock::now();
+    static int sFrames, sSlowFrames, sMinBuffered = INT32_MAX;
+    static double sWorstMs, sGameMs, sAudioWaitMs;
+
+    sFrames++;
+    sSlowFrames += frameMs > 1000.0 / 30;
+    sWorstMs = std::max(sWorstMs, frameMs);
+    sGameMs += gameMs;
+    sAudioWaitMs += audioWaitMs;
+    sMinBuffered = std::min(sMinBuffered, GameEngine_GetAudioBufferedBeforeUpdate());
+
+    const double elapsed = std::chrono::duration<double>(Clock::now() - sStart).count();
+    if (elapsed >= 5.0) {
+        SPDLOG_INFO("Frame pacing: {:.1f} fps, {} frames over 33 ms, worst {:.1f} ms, avg game+render {:.1f} ms, "
+                    "avg audio wait {:.1f} ms, min audio queued before update {} samples",
+                    sFrames / elapsed, sSlowFrames, sWorstMs, sGameMs / sFrames, sAudioWaitMs / sFrames,
+                    sMinBuffered);
+        sStart = Clock::now();
+        sFrames = sSlowFrames = 0;
+        sWorstMs = sGameMs = sAudioWaitMs = 0;
+        sMinBuffered = INT32_MAX;
+    }
+}
+
 void push_frame() {
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point sLastFrame = Clock::now();
     ApplyPendingReset();
     GameEngine::StartAudioFrame();
+    const Clock::time_point gameStart = Clock::now();
     GameEngine::Instance->StartFrame();
     thread5_iteration();
+    const Clock::time_point gameEnd = Clock::now();
     GameEngine::EndAudioFrame();
+    const Clock::time_point frameEnd = Clock::now();
+    LogFramePacing(std::chrono::duration<double, std::milli>(frameEnd - sLastFrame).count(),
+                   std::chrono::duration<double, std::milli>(gameEnd - gameStart).count(),
+                   std::chrono::duration<double, std::milli>(frameEnd - gameEnd).count());
+    sLastFrame = frameEnd;
     // thread5_game_loop();
     // Graphics_ThreadUpdate();w
 }
