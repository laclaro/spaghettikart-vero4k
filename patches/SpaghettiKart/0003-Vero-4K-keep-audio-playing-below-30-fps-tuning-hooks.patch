 #ifndef __SWITCH__
     Ship::Context::GetRawInstance()->GetLogger()->set_level(
@@ -483,6 +492,13 @@ void GameEngine::ProcessGfxCommands(Gfx* pool) {
 }
 
 // Audio
+// Queued audio when the audio thread starts a frame's update (the low point), for the frame pacing log.
+std::atomic<int> sAudioBufferedBeforeUpdate;
+
+extern "C" int GameEngine_GetAudioBufferedBeforeUpdate() {
+    return sAudioBufferedBeforeUpdate;
+}
+
 void GameEngine::HandleAudioThread() {
     while (audio.running) {
         {
@@ -497,27 +513,47 @@ void GameEngine::HandleAudioThread() {
         }
         std::unique_lock<std::mutex> Lock(audio.mutex);
 
-        int samples_left = AudioPlayerBuffered();
-        u32 num_audio_samples = samples_left < AudioPlayerGetDesiredBuffered() ? SAMPLES_HIGH : SAMPLES_LOW;
-
-        s16 nas_buffer[SAMPLES_PER_FRAME] = { 0 };
-        f32 hmas_buffer[SAMPLES_PER_FRAME] = { 0 };
-        s16 mix_buffer[SAMPLES_PER_FRAME] = { 0 };
+        // Audio is generated once per game frame, so below 30 fps (slow GPUs such as the Mali-450) the buffer runs
+        // dry and the sound stutters. Generate extra updates until enough is queued to outlast the next frame,
+        // judged by the slowest recent frame (decaying over ~2 s), plus one device buffer: SDL takes whole device
+        // buffers from the queue and pads a short one with silence. The sound then plays on in real time while the
+        // game runs slow. The target stays below the 6000 samples at which the SDL player drops audio.
+        using Clock = std::chrono::steady_clock;
+        static Clock::time_point sLastUpdate = Clock::now();
+        static double sSlowFrameMs = 0;
+        const Clock::time_point now = Clock::now();
+        const double frameMs = std::chrono::duration<double, std::milli>(now - sLastUpdate).count();
+        sLastUpdate = now;
+        sSlowFrameMs = std::max(std::min(frameMs, 250.0), sSlowFrameMs * 0.97);
+        const auto player = Ship::Context::GetRawInstance()->GetAudio()->GetAudioPlayer();
+        const int deviceSamples = player != nullptr ? player->GetSampleLength() : 512;
+        const int target =
+            std::clamp((int)(1.25 * sSlowFrameMs * GameEngine_GetSampleRate() / 1000) + deviceSamples,
+                       AudioPlayerGetDesiredBuffered(), 5000);
+        sAudioBufferedBeforeUpdate = AudioPlayerBuffered();
+        for (int update = 0; update < 6 && (update == 0 || AudioPlayerBuffered() < target); update++) {
+            int samples_left = AudioPlayerBuffered();
+            u32 num_audio_samples = samples_left < AudioPlayerGetDesiredBuffered() ? SAMPLES_HIGH : SAMPLES_LOW;
+
+            s16 nas_buffer[SAMPLES_PER_FRAME] = { 0 };
+            f32 hmas_buffer[SAMPLES_PER_FRAME] = { 0 };
+            s16 mix_buffer[SAMPLES_PER_FRAME] = { 0 };
+
+            for (size_t i = 0; i < NUM_AUDIO_CHANNELS; i++) {
+                create_next_audio_buffer(nas_buffer + i * (num_audio_samples * 2), num_audio_samples);
+            }
 
-        for (size_t i = 0; i < NUM_AUDIO_CHANNELS; i++) {
-            create_next_audio_buffer(nas_buffer + i * (num_audio_samples * 2), num_audio_samples);
-        }
+            GameEngine::Instance->gHMAS->CreateBuffer((u8*)hmas_buffer, 4 * num_audio_samples * sizeof(float));
 
-        GameEngine::Instance->gHMAS->CreateBuffer((u8*)hmas_buffer, 4 * num_audio_samples * sizeof(float));
+            float master_vol = CVarGetFloat("gGameMasterVolume", 1.0f);
 
-        float master_vol = CVarGetFloat("gGameMasterVolume", 1.0f);
+            for (size_t i = 0; i < SAMPLES_PER_FRAME; i++) {
+                mix_buffer[i] = nas_buffer[i] + ((int16_t)(hmas_buffer[i] * 32767.0f) * master_vol);
+            }
 
-        for (size_t i = 0; i < SAMPLES_PER_FRAME; i++) {
-            mix_buffer[i] = nas_buffer[i] + ((int16_t)(hmas_buffer[i] * 32767.0f) * master_vol);
+            AudioPlayerPlayFrame((u8*) mix_buffer, 2 * num_audio_samples * 4);
         }
 
-        AudioPlayerPlayFrame((u8*) mix_buffer, 2 * num_audio_samples * 4);
-
         audio.processing = false;
         audio.cv_from_thread.notify_one();
     }
