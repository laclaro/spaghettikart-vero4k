<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.launch.spaghettikart" name="SpaghettiKart" version="1.0.0" provider-name="spaghettikart-cross">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <!-- Listed under both Games and Programs. -->
        <provides>game executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Mario Kart 64 PC port</summary>
        <description lang="en_GB">Starts SpaghettiKart from ~/spaghettikart: Kodi is stopped while the game runs and restarted when it exits.</description>
        <platform>linux</platform>
        <assets>
            <icon>icon.png</icon>
            <poster>banner.jpg</poster>
        </assets>
    </extension>
</addon>
